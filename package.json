{
  "name": "dsh-session-api",
  "version": "1.4.1",
  "description": "Local HTTP control surface for DeepSeek Harness sessions: read run state and drive prompt, model, permission, queue and cancel from outside the page.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./locale/*.json": "./locale/*.json",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node tests/api.test.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "api",
    "automation",
    "remote-control"
  ],
  "author": "yukre",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yukre/dsh-session-api.git"
  },
  "homepage": "https://github.com/yukre/dsh-session-api#readme",
  "bugs": {
    "url": "https://github.com/yukre/dsh-session-api/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
